# Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# Mot de passe du site. TANT QU'IL N'EST PAS DÉFINI, LE SITE EST PUBLIC :
# n'importe qui connaissant l'adresse peut envoyer une image ou vider la
# galerie. L'interface affiche un avertissement dans ce cas.
SITE_PASSWORD=

# Jeton du Raspberry Pi, à recopier dans DEVICE_TOKEN de pi/update_display.py.
# Protège /api/state, /api/next-image et /api/heartbeat, que le Pi joint sans
# navigateur donc sans cookie. Non défini = ces trois routes restent ouvertes.
DEVICE_TOKEN=

# Mode « album du jour » uniquement.
# https://developer.spotify.com/dashboard : créer une app, cocher Web API.
# Le flux Client Credentials suffit, aucune connexion utilisateur n'est requise,
# mais la playlist visée doit être publique et t'appartenir : depuis le
# 27 novembre 2024, les playlists éditoriales de Spotify sont inaccessibles
# aux applications créées après cette date.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# À créer toi-même (openssl rand -hex 32) et à poser sur Vercel : Vercel le
# renvoie alors en « Authorization: Bearer … » sur les appels de cron.
# Facultatif ; s'il est défini, /api/album/refresh n'accepte plus que le cron
# signé ou une session du site.
CRON_SECRET=
