[Unit]
Description=Cadre e-ink : demandes envoyées depuis la page web
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/tekpi-eink/pi
EnvironmentFile=/home/pi/tekpi-eink/pi/cadre.env
ExecStart=/usr/bin/python3 /home/pi/tekpi-eink/pi/cadre.py --sync
TimeoutStartSec=300
