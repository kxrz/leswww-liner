[Unit]
Description=Liner: redraw the e-ink frame
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/tekpi-eink/pi
EnvironmentFile=-/home/pi/tekpi-eink/pi/liner.env
ExecStart=/usr/bin/python3 /home/pi/tekpi-eink/pi/liner.py
TimeoutStartSec=300
