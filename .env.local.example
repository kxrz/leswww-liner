# Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# Mode « album du jour » uniquement.
# https://developer.spotify.com/dashboard : créer une app, cocher Web API.
# Le flux Client Credentials suffit, aucune connexion utilisateur n'est requise,
# mais la playlist visée doit être publique et t'appartenir : depuis le
# 27 novembre 2024, les playlists éditoriales de Spotify sont inaccessibles
# aux applications créées après cette date.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Renseigné automatiquement par Vercel quand un cron est configuré.
# S'il est défini, /api/album/refresh exige ce jeton en Bearer.
CRON_SECRET=
