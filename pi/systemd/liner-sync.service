[Unit]
Description=Liner: requests sent from the web page
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/liner/pi
EnvironmentFile=/home/pi/liner/pi/liner.env
ExecStart=/usr/bin/python3 /home/pi/liner/pi/liner.py --sync
TimeoutStartSec=300
# Hardening: no privilege escalation, private /tmp, system files read-only (SPI and GPIO stay reachable)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
