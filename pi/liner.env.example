# Copy to liner.env, then run ./install.sh.

# The part of the panel your frame's mat leaves visible: left,top,right,bottom. Measure it with calibrate.py.
LINER_VISIBLE=52,35,748,480

# The feed to follow by default (the control room can switch it).
LINER_FEED=https://www.320kbps.club/feed.xml

# The web page, if you deployed one (maps, remote control, pictures, health). Leave empty to run on your own.
LINER_URL=https://liner.leswww.com
# Same value as DEVICE_TOKEN on Vercel.
LINER_TOKEN=
